# Copy this file to .env. Never commit the populated .env file.

# Required: semantic extraction and default LightRAG LLM provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required for real BAAI/bge-m3 retrieval. The service appends /embeddings
# when EMBEDDING_BASE_URL does not already end with that path.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# Optional Python interpreter overrides. The launchers detect .venv by default.
PYTHON_EXECUTABLE=
PYTHON_KNOWLEDGE_EXECUTABLE=

# Local service addresses.
PYTHON_AI_SERVICE_HOST=127.0.0.1
PYTHON_AI_SERVICE_PORT=8001
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8001
PYTHON_KNOWLEDGE_SERVICE_HOST=127.0.0.1
PYTHON_KNOWLEDGE_SERVICE_PORT=8002
PYTHON_KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8002
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=8003

# LightRAG runtime. LIGHTRAG_LLM_API_KEY falls back to DEEPSEEK_API_KEY.
LIGHTRAG_ENABLED=true
LIGHTRAG_WORKING_DIR=runtime/lightrag
LIGHTRAG_LLM_MODEL=deepseek-v4-flash
LIGHTRAG_LLM_API_KEY=
LIGHTRAG_LLM_BASE_URL=https://api.deepseek.com
LIGHTRAG_EMBEDDING_DIM=1024
LIGHTRAG_EMBEDDING_MAX_TOKENS=8192
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_TIMEOUT_SECONDS=45
LIGHTRAG_STARTUP_TIMEOUT_SECONDS=600

# Optional real-model evaluation setting.
DEEPSEEK_EVAL_RUNS=2
