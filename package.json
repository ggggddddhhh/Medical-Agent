{
  "name": "medical-safety-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "A verifiable medical safety agent MVP for disposition and care preparation.",
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.13",
    "zod": "4.5.4"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "test:python": "node scripts/run-python-tests.js",
    "test:orchestrator": "npm --prefix prototypes/phase5-orchestrator test",
    "test:rag:live": "node --env-file-if-exists=.env scripts/run-phase3-live-rag-smoke.js",
    "test:web": "npm --prefix web test",
    "build:web": "npm --prefix web run build",
    "test:all": "npm test && npm run test:python && npm run test:orchestrator && npm run test:web && npm run build:web",
    "start:agent-api": "node --env-file-if-exists=.env scripts/run-phase3-agent-api.js",
    "start:python-ai": "node --env-file-if-exists=.env scripts/run-python-ai-service.js",
    "start:python-knowledge": "node --env-file-if-exists=.env scripts/run-python-knowledge-service.js",
    "start:demo": "node --env-file-if-exists=.env scripts/run-phase4-demo-api.js",
    "start:web": "npm --prefix web run dev",
    "eval:deepseek": "node --env-file-if-exists=.env scripts/run-phase-2a-deepseek-evaluation.js",
    "eval:deepseek:phase2a1": "node --env-file-if-exists=.env scripts/run-phase-2a1-deepseek-evaluation.js",
    "eval:deepseek:phase2a2": "node --env-file-if-exists=.env scripts/run-phase-2a2-deepseek-evaluation.js",
    "eval:deepseek:phase2a3": "node --env-file-if-exists=.env scripts/run-phase-2a3-deepseek-evaluation.js",
    "eval:deepseek:phase2a4": "node --env-file-if-exists=.env scripts/run-phase-2a4-deepseek-evaluation.js",
    "eval:deepseek:phase2a-promotion": "node --env-file-if-exists=.env scripts/run-phase-2a-promotion-evaluation.js",
    "eval:phase5.3": "node scripts/run-phase-5.3-stability-validation.js --write"
  },
  "engines": {
    "node": ">=22"
  }
}
